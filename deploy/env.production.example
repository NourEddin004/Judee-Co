APP_NAME="JUDE Boutique"
APP_ENV=production
# Generate once with `php artisan key:generate --show` and never change it: it encrypts the
# sessions and the owner's two-step sign-in secret, so a new key locks the owner out.
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=Asia/Amman
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

# App account: SELECT, INSERT, UPDATE, DELETE on rows only (deploy/mysql/grants.sql)
DB_CONNECTION=mysql
# Through MySQL's socket on this server: the accounts in grants.sql are @'localhost'.
DB_HOST=localhost
DB_SOCKET=/var/run/mysqld/mysqld.sock
DB_PORT=3306
DB_DATABASE=jude
DB_USERNAME=jude_app
DB_PASSWORD=

# Same-server cache, no paid service (REQ-DB-36)
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database

# Order email service: picked with the client before launch (M4), on a plan with a daily cap (REQ-CST-06).
# Keys stay on the server (REQ-SEC-42). MAIL_FROM_ADDRESS must be an address on the store's own domain.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="JUDE"

# Nightly backups (REQ-SAF-01 to 03): to another server over SFTP, for example a storage box on a
# fixed monthly plan (approved with the client in M4). The private key is a file on this server,
# readable by www-data only.
BACKUP_SFTP_HOST=
BACKUP_SFTP_PORT=22
BACKUP_SFTP_USERNAME=
BACKUP_SFTP_PRIVATE_KEY=/var/www/jude/shared/backup_key
BACKUP_SFTP_ROOT=
# Encrypts every backup (REQ-SEC-28). Long and random; keep a copy in a password manager, off this
# server, or the backups cannot be opened when they are needed.
BACKUP_ARCHIVE_PASSWORD=
# Who is emailed when a backup fails or none was made for a day.
BACKUP_NOTIFY_EMAIL=
